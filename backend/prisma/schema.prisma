datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gmailRefreshToken String?    @map("gmail_refresh_token")
  riskTolerance     String?    @default("medium") @map("risk_tolerance") // 'low' | 'medium' | 'high'
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz

  nodes             Node[]
  rawEvents         RawEvent[]
  insights          Insight[]

  @@map("users")
}

model Node {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  type       String   // 'income_source' | 'obligation' | 'goal' | 'buffer'
  label      String
  value      Decimal? @db.Decimal(12, 2)
  confidence String   // 'confirmed' | 'inferred' | 'predicted'
  metadata   Json?
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  outEdges   Edge[]   @relation("SourceNode")
  inEdges    Edge[]   @relation("TargetNode")

  @@map("nodes")
}

model Edge {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceId  String   @map("source_id") @db.Uuid
  targetId  String   @map("target_id") @db.Uuid
  relation  String   // 'funds' | 'competes_with' | 'buffers_against'
  weight    Decimal? @default(1.0) @db.Decimal(5, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  source    Node     @relation("SourceNode", fields: [sourceId], references: [id], onDelete: Cascade)
  target    Node     @relation("TargetNode", fields: [targetId], references: [id], onDelete: Cascade)

  @@map("edges")
}

model RawEvent {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String     @map("user_id") @db.Uuid
  source         String     // 'sms' | 'gmail' | 'manual'
  rawPayload     Json?      @map("raw_payload")
  fingerprint    String?
  matchedEventId String?    @map("matched_event_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz

  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchedEvent   RawEvent?  @relation("MatchedRawEvents", fields: [matchedEventId], references: [id])
  childEvents    RawEvent[] @relation("MatchedRawEvents")

  @@map("raw_events")
}

model Insight {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  triggerType String   @map("trigger_type") // 'cascade' | 'anomaly'
  severity    Decimal? @db.Decimal(5, 2)
  confidence  Decimal? @db.Decimal(5, 2)
  urgency     Decimal? @db.Decimal(5, 2)
  gateScore   Decimal? @map("gate_score") @db.Decimal(5, 2)
  status      String   // 'surfaced' | 'suppressed'
  explanation String?  @db.Text
  graphPath   Json?    @map("graph_path")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("insights")
}
