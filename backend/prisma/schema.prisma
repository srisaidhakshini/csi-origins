datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  googleId          String?       @unique @map("google_id")
  email             String?       @unique
  name              String?
  profilePicture    String?       @map("profile_picture") @db.Text
  persona           String?       @default("Freelancer")
  bufferBalance     Decimal       @default(0.0) @map("buffer_balance") @db.Decimal(12, 2)
  riskTolerance     String?       @default("medium") @map("risk_tolerance")
  gmailRefreshToken String?       @map("gmail_refresh_token") @db.Text
  smsEnabled        Boolean       @default(false) @map("sms_enabled")
  hasCompletedOnboarding Boolean  @default(false) @map("has_completed_onboarding")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz

  transactions      Transaction[]
  obligations       Obligation[]
  insights          Insight[]

  @@map("users")
}

model Transaction {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  amount          Decimal   @db.Decimal(12, 2)
  currency        String?   @default("INR")
  merchant        String
  category        String    @default("general")
  type            String    // 'debit' | 'credit'
  source          String    @default("sms") // 'sms' | 'gmail' | 'manual'
  accountNumber   String?   @map("account_number")
  referenceNumber String?   @map("reference_number")
  balance         Decimal?  @db.Decimal(12, 2)
  bankName        String?   @map("bank_name")
  fingerprint     String?   @unique
  timestamp       DateTime  @default(now()) @db.Timestamptz
  rawText         String?   @map("raw_text") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model Obligation {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  label       String
  amount      Decimal  @db.Decimal(12, 2)
  category    String   @default("general") // 'housing' | 'investment' | 'utilities' | 'income'
  type        String   @default("outflow") // 'outflow' | 'inflow'
  dueDay      Int?     @map("due_day")
  critical    Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("obligations")
}

model Insight {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  triggerType   String   @map("trigger_type") // 'shortfall' | 'anomaly' | 'reminder' | 'cascade'
  severity      Decimal? @db.Decimal(5, 2)
  status        String   @default("surfaced") // 'surfaced' | 'suppressed' | 'resolved'
  explanation   String?  @db.Text
  actions       Json?
  voiceAudio    String?  @map("voice_audio") @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("insights")
}
